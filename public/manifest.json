{
    "manifest_version": 3,
    "name": "ドラルフ神話 被ダメージ処理支援ツール",
    "version": "2.0.0",
    "description": "ドラルフ神話TRPGのダメージ処理(回避/盾/乗馬)・被ダメージ計算を支援するツールをココフォリアに追加します。",
    "icons": {
        "16": "./icons/icon16.png",
        "48": "./icons/icon48.png",
        "128": "./icons/icon128.png"
    },
    "action": {
        "default_title": "被ダメージ処理 支援ツール",
        "default_icon": {
            "16": "./icons/icon16.png",
            "48": "./icons/icon48.png",
            "128": "./icons/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["https://ccfolia.com/rooms/*"],
            "js": ["index.js"], 
            "run_at": "document_idle"
        }
    ],
    "permissions": ["storage"]
}